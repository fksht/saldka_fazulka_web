# Frontend demo admin password.
# This is only for local MVP protection. Production admin must use real auth.
VITE_ADMIN_PASSWORD=fazulka-demo

# Optional override for hosted subpath. GitHub Actions sets this automatically
# from the repository name, for example /sladka-fazulka/.
VITE_BASE_PATH=

# Optional public URL of your own secure backend/serverless endpoint.
# The endpoint should read EMAIL_API_KEY and other secrets server-side.
VITE_EMAIL_ENDPOINT=

# Server-side only variables for the email endpoint. Do not expose them in frontend code.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Sladká fazuľka <info@sladkafazulka.sk>"
EMAIL_TO=info@sladkafazulka.sk

# Future database/auth/storage integration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
